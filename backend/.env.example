# Server-only credentials. Copy to backend/.env; never commit that file.
# Start with: python -m uvicorn app.main:app --env-file .env --host 127.0.0.1 --port 8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
YOUTUBE_API_KEY=

# Optional: warm the recommendation model before API startup completes.
# start.cmd enables this automatically on Windows.
CAREERBRIDGE_PRELOAD_MODEL=1
CAREERBRIDGE_MODEL_THREADS=4
CAREERBRIDGE_MODEL_DEVICE=cpu
